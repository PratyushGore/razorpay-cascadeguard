# ==============================================================================
# CascadeGuard Environment Configuration Example
# ==============================================================================

# Database Connection (SQLite default for local zero-config run)
DATABASE_URL=sqlite:///./cascadeguard.db

# Cryptographic & Webhook Signing Secrets
SECRET_KEY=razorpay_secret_key_change_me_in_production
RAZORPAY_KEY_ID=PASTE_YOUR_RAZORPAY_KEY_ID_HERE
RAZORPAY_KEY_SECRET=PASTE_YOUR_RAZORPAY_KEY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=PASTE_YOUR_RAZORPAY_WEBHOOK_SECRET_HERE

# Google Gemini API Key
# If omitted or placeholder, CascadeGuard automatically falls back to its 
# deterministic heuristic rule engine with zero downtime and 100% compliance.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE

# Default Active Jurisdiction (IN_RBI | US_NACHA | EU_PSD3)
ACTIVE_JURISDICTION=IN_RBI
