# ==============================================================================
# CascadeGuard Environment Configuration
# ==============================================================================

# Database Connection (SQLite default for local zero-config run)
DATABASE_URL=sqlite:///./cascadeguard.db

# Cryptographic & Webhook Signing Secrets
SECRET_KEY=razorpay_secret_key_change_me_in_production
RAZORPAY_WEBHOOK_SECRET=sampleWebhookSecret

# Optional: Google Gemini API Key
# If omitted or invalid, CascadeGuard automatically falls back to its 
# deterministic heuristic rule engine with zero downtime and 100% compliance.
GEMINI_API_KEY=

# Default Active Jurisdiction (IN_RBI | US_NACHA | EU_PSD3)
ACTIVE_JURISDICTION=IN_RBI
